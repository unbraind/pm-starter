{"ts":"2026-08-31T10:40:09.147Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_instance":"c41a528b9f424137989cc889","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-starter-55ul"},{"op":"add","path":"/metadata/title","value":"Group codeql-action bumps into one pull request to end the split-PR deadlock"},{"op":"add","path":"/metadata/description","value":"Dependabot opens github/codeql-action/init and github/codeql-action/analyze as two separate pull requests, but the two actions must carry the same version in a workflow, so each pull request alone leaves the pair mismatched and the codeql check fails on BOTH. Neither can go green on its own and the deadlock has to be broken by hand every time. Measured 2026-08-31 in unbraind/pm-gantt-chart 87 and 88, where codeql is the only failing check on each while every other check is green. Fix: a dependabot groups block so every github codeql-action bump arrives as one pull request, keeping init and analyze in lockstep."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T10:40:09.147Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T10:40:09.147Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"0cd375018234cf268b4e4cc313fc1f37856e66abad25ee0d7f7f36613b4f1e01","item_hash_version":2,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
