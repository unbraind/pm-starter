  node --test --test-concurrency=2 test/identity-audit.test.ts test/sdk-floor.test.ts test/prepare-merge-driver.test.ts,project,codex-agent,"2026-11-23T09:53:08.540Z",local_mutation,codex/closure-1122/chore/in-progress-sweep-2026-11-14
  "npm run changelog:check",project,codex-agent,"2026-11-23T16:13:14.876Z",local_mutation,codex/closure-1122/chore/in-progress-sweep-2026-11-14
  "npm run release:notes",project,codex-agent,"2026-11-23T16:21:01.018Z",local_mutation,fix/changelog-keep-dependency-updates
  node --test --test-concurrency=2 test/release-workflow.test.ts,project,codex-agent,"2026-11-23T16:37:46.319Z",local_mutation,fix/changelog-keep-dependency-updates
