tests[1]{command,scope,timeout_seconds,pm_context_mode,workspace_context_mode,provenance{author,created_at,source_kind,source_ref}}:
  "node --input-type=module -e 'import assert from \"node:assert/strict\"; import {readFileSync} from \"node:fs\"; import {execFileSync} from \"node:child_process\"; import {decode} from \"@toon-format/toon\"; const main=JSON.parse(execFileSync(\"git\",[\"show\",\"origin/main:package.json\"],{encoding:\"utf8\"})); const local=JSON.parse(readFileSync(\"package.json\",\"utf8\")); assert.equal(local.scripts[\"release:check\"],main.scripts[\"release:check\"]); assert.ok(main.scripts[\"release:check\"].includes(\"npm run changelog:check\")); assert.ok(main.scripts[\"release:check\"].includes(\"npm run verify:release-publish-attestation\")); for(const name of [\"changelog\",\"changelog:full\",\"changelog:check\",\"release:notes\"]) assert.ok(main.scripts[name].includes(\"--date-from-version\")); const workflow=execFileSync(\"git\",[\"show\",\"origin/main:.github/workflows/release.yml\"],{encoding:\"utf8\"}); const calls=workflow.split(\"\\n\").filter(line=>line.includes(\"npx pm-changelog \")); assert.equal(calls.length,3); for(const line of calls) assert.ok(line.includes(\"--date-from-version\")); const path=\".agents/pm/issues/pm-starter-4n5o.toon\"; const item=decode(process.env.AUDIT_BEFORE===\"1\"?execFileSync(\"git\",[\"show\",\"01715e9:\"+path],{encoding:\"utf8\"}):readFileSync(path,\"utf8\")); assert.equal(item.status,\"closed\"); for(const text of [item.comments[2].text,item.close_reason]) {assert.ok(text.includes(\"release:check runs changelog:check with --date-from-version\")); assert.ok(text.includes(\"verify:release-publish-attestation\")); assert.ok(!text.includes(\"version-date verifier\"));} console.log(\"PASS: 18 tracker evidence assertions against main \"+execFileSync(\"git\",[\"rev-parse\",\"origin/main\"],{encoding:\"utf8\"}).trim());'",project,300,tracker,source,codex-agent,"2026-10-22T12:13:35.252Z",local_mutation,chore/reconcile-tracker-1021
