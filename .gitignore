coverage/

# SDK workspace-transaction journals are runtime state, not tracked data.
# pm health fails closed on these (tracked_runtime_cache_files), so committing
# one turns the health gate red; the journal has no value once the transaction
# has landed. Deliberately outside any `pm-cli:` fence, which the CLI rewrites.
.agents/pm/transactions/

# Restore managed artifacts locally and in CI; track only the registry.
# The scheduled GitHub issue sync installs its pinned pm-github here and refuses
# any untracked path outside its commit scope.
.agents/pm/extensions/*
!.agents/pm/extensions/.managed-extensions.json
